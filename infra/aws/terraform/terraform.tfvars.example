aws_region         = "us-east-1"
name_prefix       = "skillwright-prod"
vpc_id            = "vpc-0123456789abcdef0"
private_subnet_ids = ["subnet-private-a", "subnet-private-b"]
public_subnet_ids  = ["subnet-public-a", "subnet-public-b"]
certificate_arn    = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
external_base_url  = "https://skillwright.example.com"
image_tag          = "git-c93e687"
# For later releases, set this to the candidate tag first, apply, run/verify the migration task,
# then promote the same tag into image_tag and clear this value.
migration_image_tag = null
bootstrap_admin_principal = "prod-admin"

# Restrict this to corporate/VPN egress CIDRs when the service is not intended for the public web.
alb_ingress_cidrs = ["0.0.0.0/0"]

# Keep services disabled on the first apply. Run the migration task, then switch this to true.
services_enabled = false

# Store the JSON token-hash map in a pre-created Secrets Manager secret. Terraform receives only
# the ARN and ECS resolves the value at task start.
service_secret_arns = {
  SKILLWRIGHT_AUTH_TOKEN_HASHES = "arn:aws:secretsmanager:us-east-1:123456789012:secret:skillwright/auth-token-hashes-AbCdEf"
}
service_secret_kms_key_arns = []

# Least-privilege resources the application task role may resolve at workflow execution time.
workflow_secrets_manager_arns = [
  "arn:aws:secretsmanager:us-east-1:123456789012:secret:skillwright/workflows/*",
]

workflow_ssm_parameter_arns = [
  "arn:aws:ssm:us-east-1:123456789012:parameter/skillwright/workflows/*",
]

workflow_kms_key_arns = []
